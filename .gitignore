# Environments
.venv/
.?env*/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Flask specific
instance/
.webassets-cache
flask_session/
*.bak
.hintrc

#VS Code
.vscode
.vscode/

# OTHER RANDOM
.pytest_cache/
.coverage
htmlcov/

dist/
build/
*.egg-info/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec
