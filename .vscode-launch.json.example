{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Shorty: Flask (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--host",
                "0.0.0.0",
                "--port",
                "5015"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "FLASK_APP": "manage:app",
                "FLASK_DEBUG": "1"
            },
            "jinja": true
        }
    ]
}
