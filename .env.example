# Flask CLI/dev server settings
FLASK_APP=App.webapp
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5004
# Optional for older Flask tooling; safe to keep as development.
FLASK_ENV=development

# App config class:
# - config.DevelopmentConfig for local development
# - config.TestingConfig for automated tests
# - config.ProductionConfig for deployed environments
APP_SETTINGS=config.DevelopmentConfig

# Security and access
# Use a long random value (do not keep this example in real deployments).
SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated usernames that can access /admin.
SHORTY_ADMIN_USERS=pgilm
# Set to 1 when serving over HTTPS (recommended for production).
FORCE_SECURE_COOKIES=0
# Keep 1 behind nginx/ALB/reverse proxy; set 0 for direct local runs.
ENABLE_PROXYFIX=1

# Data and app identity
# Local SQLite example. Production often uses postgresql://...
DATABASE_URL=sqlite:///db.sqlite
APP_NAME="SHORTY - Desktop Companion"
